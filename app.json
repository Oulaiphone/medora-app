{
  "expo": {
    "name": "MedOra",
    "slug": "medora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medora",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E6A55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medora.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E6A55",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E6A55"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedOra uses the camera to read medicine labels.",
          "photosPermission": "MedOra reads medicine labels from photos you choose.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MedOra uses the camera to read medicine labels.",
        "NSPhotoLibraryUsageDescription": "MedOra reads medicine labels from photos you choose."
      }
    }
  }
}